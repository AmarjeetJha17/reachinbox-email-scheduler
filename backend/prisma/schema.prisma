generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SenderStatus {
  ACTIVE
  PAUSED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EmailJobStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RETRYING
  RATE_LIMITED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  role      UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   SenderAccount[]
  campaigns Campaign[]

  @@index([googleId])
}

model SenderAccount {
  id                    String       @id @default(uuid())
  userId                String
  name                  String
  fromEmail             String
  smtpHost              String
  smtpPort              Int
  smtpUser              String
  smtpPasswordEncrypted String
  secure                Boolean      @default(false)
  status                SenderStatus @default(ACTIVE)

  hourlyLimit           Int          @default(200)

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emailJobs EmailJob[]

  @@index([userId])
  @@index([status])
}

model Campaign {
  id                 String         @id @default(uuid())
  userId             String
  senderId           String

  subject            String
  body               String

  startAt            DateTime
  delayBetweenEmails Int            @default(2000)
  hourlyLimit        Int            @default(200)

  status             CampaignStatus @default(DRAFT)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender     SenderAccount @relation(fields: [senderId], references: [id])
  emailJobs  EmailJob[]

  @@index([userId, status])
  @@index([senderId, status])
  @@index([startAt])
}

model EmailJob {
  id             String         @id @default(uuid())
  campaignId     String
  senderId       String

  recipientEmail String
  recipientName  String?

  subject        String
  body           String

  scheduledAt    DateTime
  nextAttemptAt  DateTime?

  status         EmailJobStatus @default(SCHEDULED)

  bullJobId      String?        @unique
  idempotencyKey String         @unique

  attemptCount   Int            @default(0)

  sentAt         DateTime?
  failedAt       DateTime?

  providerMessageId String?
  previewUrl        String?
  errorMessage      String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   SenderAccount @relation(fields: [senderId], references: [id])

  @@index([campaignId, status])
  @@index([senderId, status])
  @@index([scheduledAt, status])
  @@index([nextAttemptAt])
}